{
  "expo": {
    "name": "今日作业",
    "slug": "homework-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "homework",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goxofy.homework",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "用于录制作业语音讲解附件,方便家长补充说明。",
        "NSPhotoLibraryUsageDescription": "用于选择您自己的作业图片作为作业附件。附件只上传到您自建的服务器,应用不会访问、收集或上传到其他任何地方。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.family.homeworkapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "./plugins/withAndroidBuildTuning",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "用于选择您自己的作业图片作为作业附件。附件只上传到您自建的服务器。",
          "cameraPermission": false
        }
      ],
      "expo-video",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 24,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
